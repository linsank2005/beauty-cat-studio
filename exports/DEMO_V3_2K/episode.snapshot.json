  "sources": [],
  "narration": [
    {
      "id": "N01",
      "text": "我只是想出门前，收拾一下。",
      "estimated": {
        "start": 0,
        "end": 6
      },
      "actual": {
        "start": 0.18,
        "end": 2.544
      }
    },
    {
      "id": "N02",
      "text": "结果一照镜子，脑子里开了八个项目。",
      "estimated": {
        "start": 6,
        "end": 9.5
      },
      "actual": {
        "start": 2.88,
        "end": 6.08
      }
    },
    {
      "id": "N03",
      "text": "头发、黑眼圈、穿搭，连人生都想重做。",
      "estimated": {
        "start": 9.5,
        "end": 14
      },
      "actual": {
        "start": 6.34,
        "end": 10.74
      }
    },
    {
      "id": "N04",
      "text": "等一下，这是洗手台，不是施工现场。",
      "estimated": {
        "start": 14,
        "end": 18
      },
      "actual": {
        "start": 10.964,
        "end": 14.144
      }
    },
    {
      "id": "N05",
      "text": "今天先选一件：把头发整理好。",
      "estimated": {
        "start": 18,
        "end": 22.5
      },
      "actual": {
        "start": 14.364,
        "end": 16.914
      }
    },
    {
      "id": "N06",
      "text": "剩下的事，回来再说。",
      "estimated": {
        "start": 22.5,
        "end": 25
      },
      "actual": {
        "start": 17.204,
        "end": 19.384
      }
    },
    {
      "id": "N07",
      "text": "看，我没变成另一只猫。",
      "estimated": {
        "start": 25,
        "end": 28.5
      },
      "actual": {
        "start": 19.804,
        "end": 21.924
      }
    },
    {
      "id": "N08",
      "text": "只是终于肯出门啦。",
      "estimated": {
        "start": 28.5,
        "end": 32
      },
      "actual": {
        "start": 22.324,
        "end": 23.936
      }
    }
  ],
